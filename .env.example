# API-Football v3 (https://www.api-football.com/documentation-v3)
# Base URL is hardcoded in lib/api-football/client.ts to https://v3.football.api-sports.io
API_FOOTBALL_KEY=your_api_football_key

# OpenAI (https://platform.openai.com/docs/models)
OPENAI_API_KEY=sk-proj-your_openai_key
# Model used for analysis. Override here if you want a different one.
OPENAI_MODEL=gpt-5.4-mini

# Supabase
# Project URL and anon key — public, browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service-role key — SERVER-ONLY. Never expose to the browser.
# Every database read/write goes through this key: there is no Supabase Auth
# in this app, so RLS denies the anon role by default.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# InfinitePay checkout (https://www.infinitepay.io/checkout-documentacao)
# ---------------------------------------------------------------------------
# Your InfiniteTag (username in the InfinitePay app), WITHOUT the leading "$".
# Integrated Checkout must be enabled in your InfinitePay account, otherwise
# the API answers "external_checkout_not_enabled".
INFINITEPAY_HANDLE=your_infinitetag

# Absolute public URL of this deployment. InfinitePay calls our redirect and
# webhook from the outside, so localhost will not receive webhooks in dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Set to "false" ONLY for local testing without reaching InfinitePay.
# Leaving it on is what prevents a forged webhook from minting access codes.
# INFINITEPAY_WEBHOOK_VERIFY=true

# ---------------------------------------------------------------------------
# Access codes
# ---------------------------------------------------------------------------
# The owner's permanent code — always valid, never expires.
#
# There is NO default: this value is a credential, so it must never be
# committed. Pick something only you know and set it here and in your hosting
# provider. If it is left unset there is simply no master code, and only
# codes stored in the access_codes table work.
MASTER_ACCESS_CODE=
