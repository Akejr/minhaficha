# API-Football v3 (https://www.api-football.com/documentation-v3)
# Base URL is hardcoded in lib/api-football/client.ts to https://v3.football.api-sports.io
API_FOOTBALL_KEY=your_api_football_key

# OpenAI (https://platform.openai.com/docs/models)
OPENAI_API_KEY=sk-proj-your_openai_key
# Model used for analysis. Override here if you want a different one.
OPENAI_MODEL=gpt-5.4-mini

# Supabase
# Project URL and anon key — public, browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service-role key — SERVER-ONLY. Never expose to the browser.
# Every database read/write goes through this key: there is no Supabase Auth
# in this app, so RLS denies the anon role by default.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# InfinitePay checkout (https://www.infinitepay.io/checkout-documentacao)
# ---------------------------------------------------------------------------
# Your InfiniteTag (username in the InfinitePay app), WITHOUT the leading "$".
# Integrated Checkout must be enabled in your InfinitePay account, otherwise
# the API answers "external_checkout_not_enabled".
INFINITEPAY_HANDLE=your_infinitetag

# Absolute public URL of this deployment. InfinitePay calls our redirect and
# webhook from the outside, so localhost will not receive webhooks in dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Set to "false" ONLY for local testing without reaching InfinitePay.
# Leaving it on is what prevents a forged webhook from minting access codes.
# INFINITEPAY_WEBHOOK_VERIFY=true

# ---------------------------------------------------------------------------
# Access codes
# ---------------------------------------------------------------------------
# The owner's permanent code — always valid, never expires.
#
# There is NO default: this value is a credential, so it must never be
# committed. Pick something only you know and set it here and in your hosting
# provider. If it is left unset there is simply no master code, and only
# codes stored in the access_codes table work.
MASTER_ACCESS_CODE=

# ---------------------------------------------------------------------------
# Conversion tracking (Meta Pixel + Conversions API, Google Ads)
# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With none of it set the app behaves exactly as
# before: no tags load and every track() call is a no-op.

# Meta Pixel id. Read on the server and injected into the page, so it needs no
# NEXT_PUBLIC_ prefix even though it ends up visible in the HTML (every pixel
# id does — that is not a leak).
META_PIXEL_ID=

# Conversions API token. SERVER-ONLY, and the one value here that is a real
# secret: it can write events to your pixel. Never give it a NEXT_PUBLIC_
# prefix and never reference it from a client component.
META_CAPI_ACCESS_TOKEN=

# Set while validating to route events to the Test Events tab in Events
# Manager. MUST be empty in production, or live conversions stop counting.
META_TEST_EVENT_CODE=

# Graph API version used for the Conversions API. Meta expires a version about
# two years after release and an expired one fails the whole call, so it is
# overridable here. Confirm the current version in Events Manager if you see
# version errors in conversion_events.detail.
# META_GRAPH_VERSION=v26.0

# Forward the visitor's IP to Meta to improve match quality.
#
# OFF by default and that is deliberate: this app never stores a raw IP (see
# hashIp in lib/analytics/events.ts), so sending one to a third party is a
# privacy decision, not a tuning knob. Turn it on only once your privacy
# policy says so.
# META_CAPI_SEND_IP=false

# Google tag id — "G-XXXXXXX" (GA4) or "AW-XXXXXXXXX" (Google Ads).
GOOGLE_TAG_ID=

# Google Ads purchase conversion. Both are required for the conversion to
# fire; with either missing the tracker is skipped.
#   GOOGLE_ADS_CONVERSION_ID   → AW-123456789
#   GOOGLE_ADS_PURCHASE_LABEL  → the label from the conversion snippet
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_PURCHASE_LABEL=
